# Dockerfile for Kafka Producer
# Lightweight Python container for fetching OpenSky data and publishing to Kafka

FROM python:3.11-slim

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir \
    confluent-kafka==2.3.0 \
    requests==2.31.0 \
    python-dotenv==1.0.0

# Copy producer code
COPY kafka/ /app/kafka/
COPY config/ /app/config/

# Set Python path
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Health check
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD pgrep -f "python" || exit 1

# Run the producer
CMD ["python", "-m", "kafka.kafka_producer"]
